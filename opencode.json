{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "compaction": { "auto": true, "keep": { "tokens": 10000 } },
  "instructions": [ ".opencode/memory/MEMORY.md" ],
  "plugins": [ "@upstash/context7-opencode" ],
  "mcp": {
    "timeout": { "startup": 60000 },
    "servers": {
      "unity-mcp": {
        "type": "local",
        "command": [ "C:/Users/litn0/.unity/relay/relay_win.exe", "--mcp" ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {env:CONTEXT7_API_KEY}" }
      }
    }
  }
}
