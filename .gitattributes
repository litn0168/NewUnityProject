# ---------------------------------------------------------------------------
# Line-ending + binary handling for this Unity 6 project.
#
# Git LFS is enabled for large media assets (textures, 3D models, audio, video
# and archives). LFS-tracked objects are stored and served through the GitHub
# LFS quota: storage and bandwidth are billed against that quota, so commit
# large media deliberately and prune it when it is replaced.
#
# Small plugin binaries (.dll/.so/.dylib) intentionally stay as normal blobs:
# they are small, and routing them through LFS would only add pointer overhead
# without any bandwidth benefit.
# ---------------------------------------------------------------------------
* text=auto

# Source and config: always LF
*.cs       text eol=lf
*.shader   text eol=lf
*.cginc    text eol=lf
*.hlsl     text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.asmdef   text eol=lf
*.asmref   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Large media assets: stored in Git LFS (never diffed, never EOL-converted)
*.png         filter=lfs diff=lfs merge=lfs -text
*.jpg         filter=lfs diff=lfs merge=lfs -text
*.jpeg        filter=lfs diff=lfs merge=lfs -text
*.tga         filter=lfs diff=lfs merge=lfs -text
*.psd         filter=lfs diff=lfs merge=lfs -text
*.exr         filter=lfs diff=lfs merge=lfs -text
*.hdr         filter=lfs diff=lfs merge=lfs -text
*.fbx         filter=lfs diff=lfs merge=lfs -text
*.obj         filter=lfs diff=lfs merge=lfs -text
*.blend       filter=lfs diff=lfs merge=lfs -text
*.wav         filter=lfs diff=lfs merge=lfs -text
*.mp3         filter=lfs diff=lfs merge=lfs -text
*.ogg         filter=lfs diff=lfs merge=lfs -text
*.mp4         filter=lfs diff=lfs merge=lfs -text
*.mov         filter=lfs diff=lfs merge=lfs -text
*.webm        filter=lfs diff=lfs merge=lfs -text
*.zip         filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Small plugin binaries: normal blobs, never diff, never EOL-convert
*.dll       binary
*.so        binary
*.dylib     binary

# Unity YAML + meta: text, normalized to LF
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.controller text eol=lf
*.anim       text eol=lf
*.meta       text eol=lf

# ---------------------------------------------------------------------------
# Unity YAML serialized assets
#
# .unity, .prefab, .asset, .mat, .controller, .anim are TEXT files, in fact
# generated by the Unity Editor and keyed by GUIDs + fileIDs. They are marked
# text so they normalize to LF and churn stays low; that normalization has no
# effect on how a merge is performed.
#
# Git attributes cannot block an automatic textual 3-way merge, and
# GitHub-side merges never honor a merge driver. The actual guard is
# one-owner-per-scene/prefab discipline, plus re-opening the merged asset in
# the Unity Editor and verifying it before trusting the result.
#
# An optional local-only driver (UnityYAMLMerge) can be configured by the user
# in .git/config. Do NOT add a `merge=unityyamlmerge` line here: an undefined
# driver attribute can break merges. Never use `merge=union` for these files.
# ---------------------------------------------------------------------------
